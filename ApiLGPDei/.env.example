PORT=3334
APP_ENV=development
# MongoDB from docker-compose.yml + docker-compose.dev.yml (credentials from the root .env)
MONGODB_URI=mongodb://lgpdei:change-me-strong-password@127.0.0.1:27017/lgpdei?authSource=admin
# Use long random values (32+ chars). In APP_ENV=production, placeholders like change-me-* are rejected.
SESSION_SECRET=dev-only-replace-with-random-session-secret-32chars
JWT_SECRET=dev-only-replace-with-random-jwt-secret-32-characters
JWT_EXPIRES_DAYS=7
SESSION_TTL_HOURS=72
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5
CORS_ORIGINS=http://localhost:3000
# COOKIE_SECURE defaults to true; set it to false only for local development over plain http.
# Use COOKIE_SAMESITE=none when web and API are on different sites (HTTPS only).
# When COOKIE_SAMESITE=none, mutating /api requests must send header X-Requested-With: LGPDei.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Docker image only: IPs of the reverse proxy allowed to set X-Forwarded-For.
FORWARDED_ALLOW_IPS=127.0.0.1
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SESSIONS_PER_HOUR=5
RATE_LIMIT_MESSAGES_PER_HOUR=30
RATE_LIMIT_UPLOADS_PER_HOUR=10
MAX_FILES_PER_SESSION=10
MAX_FILE_SIZE_MB=5
MAX_EXTRACTED_TEXT_CHARS=50000
PAGEINDEX_MIN_CHARS=8000
MAX_RETRIEVED_CHARS=24000
MAX_CORPUS_RETRIEVED_CHARS=16000
# off | warn | block — heuristic only; does not claim perfect PII filtering
PII_MODE=warn
